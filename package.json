{
  "name": "dsh-approval-alert",
  "version": "0.2.0",
  "description": "DSH 审批/提问提醒:提示音 + 右下角浮层,点「去处理」直接跳到发起审批的会话;音效、音量、重复次数与自定义音效均可配置 · Sound + jump-back reminder for DeepSeek Harness pending approvals.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "approval",
    "reminder",
    "sound",
    "alert",
    "cui"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "scripts",
    "test"
  ],
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "license": "MIT"
}
